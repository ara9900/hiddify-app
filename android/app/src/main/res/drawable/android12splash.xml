<?xml version="1.0" encoding="utf-8"?>
<!-- Same color as splash bg so the Android 12 centered icon is invisible.
     Transparent drawables are often replaced by the launcher icon on OEM skins. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size android:width="288dp" android:height="288dp" />
    <solid android:color="@color/tiknet_splash_bg" />
</shape>
